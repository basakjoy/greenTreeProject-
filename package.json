    "@react-email/render": "^1.0.5",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "jose": "^6.0.8",
    "lucide-react": "^0.479.0",
    "next": "15.2.1",
