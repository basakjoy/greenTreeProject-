# ==============================================================================
# GreenTree Building Consultants (GTBC) - Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/greentree_db

# Admin Authentication & Sessions
# Generate with: openssl rand -base64 32
AUTH_SECRET=super_secret_session_key_min_32_characters_greentree_2025

# Resend Email Service
RESEND_API_KEY=re_123456789_placeholder
EMAIL_FROM=GreenTree Notifications <noreply@greentreebd.com>
HR_NOTIFICATION_EMAIL=careers@greentreebd.com
CONTACT_NOTIFICATION_EMAIL=contact@greentreebd.com

# Cloudflare R2 / S3-Compatible Storage for Resumes
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_BUCKET_NAME=greentree-resumes
R2_ENDPOINT=https://placeholder_r2_account_id.r2.cloudflarestorage.com

# Cloudflare Turnstile Spam Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Analytics (Optional, Plausible or GA4)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=greentreebd.com
